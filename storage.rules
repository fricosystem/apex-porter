rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // Ronda photos are the only Storage path currently used by the app.
    // Access remains authenticated, preserving the existing operational flow.
    match /rondas/{year}/{month}/{rondaId}/{fileName} {
      allow read, write: if signedIn();
    }

    // Deny any unrecognized path by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
