rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDocument(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function isPrivileged() {
      return signedIn()
        && exists(userDocument(request.auth.uid))
        && get(userDocument(request.auth.uid)).data.get('cargo', '') in ['DIRETOR', 'DESENVOLVEDOR', 'Diretor', 'Desenvolvedor'];
    }

    function profileDataIsSafe() {
      return !(request.resource.data.get('cargo', '') in ['DIRETOR', 'DESENVOLVEDOR', 'Diretor', 'Desenvolvedor', 'ADMIN', 'Administrador'])
        && request.resource.data.get('permissoes', []).hasAny(['admin']) == false;
    }

    function selfProfileUpdateIsSafe() {
      return profileDataIsSafe()
        && request.resource.data.get('cargo', '') == resource.data.get('cargo', '')
        && request.resource.data.get('permissoes', []) == resource.data.get('permissoes', []);
    }

    // User profiles: users can access their own profile; only privileged roles
    // can administer the directory and change other users' access metadata.
    match /usuarios/{uid} {
      allow read: if isOwner(uid) || isPrivileged();
      allow create: if isOwner(uid) && profileDataIsSafe();
      allow update: if isPrivileged() || (isOwner(uid) && selfProfileUpdateIsSafe());
      allow delete: if isPrivileged();

      // Device tokens are private to their owner. Cloud Functions use the
      // Admin SDK and are not constrained by these client rules.
      match /pushTokens/{tokenId} {
        allow read, write: if isOwner(uid);
      }

      // Future user-scoped settings/subcollections remain private to the user.
      match /{subcollection}/{documentId} {
        allow read, write: if isOwner(uid);
      }
    }

    // The operational collections are available only after Firebase Auth.
    // No anonymous client can read or mutate industrial access records.
    match /{collection}/{documentId} {
      allow read, write: if signedIn() && collection in [
        'empresas', 'departamentos', 'pessoas', 'ramais', 'postos', 'cargos',
        'registrosFluxo', 'pesagem_apara', 'pesagem_solvente', 'veiculos',
        'preAutorizacoes', 'ocorrencias', 'listaNegra', 'achadosPerdidos',
        'avisos', 'rondas', 'rotas', 'checklists', 'inspecoes', 'protocolos',
        'ativacoes', 'config', 'lembretes', 'chaves'
      ];
    }

    // Fallback event stream used by authenticated clients while Cloud
    // Functions are unavailable on the Spark plan. Only the event author may
    // create an event; all authenticated users may receive matching events.
    match /notificationEvents/{eventId} {
      allow create: if signedIn()
        && request.resource.data.get('authorUid', '') == request.auth.uid;
      allow read: if signedIn();
      allow update, delete: if false;
    }

    // Push-test requests are self-targeted. Background processing, when
    // enabled later, is performed by the Admin SDK.
    match /pushTestRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.get('requestedByUid', '') == request.auth.uid
        && request.resource.data.get('targetUid', '') == request.auth.uid;
      allow read: if signedIn()
        && resource.data.get('requestedByUid', '') == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
